# Видео и звук не храним в GitHub: они остаются в папке на Mac
*.mp4
*.mov
*.mp3
*.wav
*.zip
.DS_Store
.probe
.wtest
входящие/старые/git-*

__pycache__/
*.pyc

# озвучка ролика хранится в GitHub (≈8 МБ), чтобы новые чаты брали её сами
!ролики/*/озвучка.mp3
# Монтаж: зависимости, модели, рендеры и исходники не храним в git
монтаж/remotion/node_modules/
монтаж/remotion/out/
монтаж/модели/
монтаж/исходники/
монтаж/результаты/
*.m4a
*.mkv
*.webm
*.flac
